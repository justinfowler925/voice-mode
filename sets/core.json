{
  "name": "core",
  "description": "The minimum verified set. Every binding is in a tier that survives Electron composers.",
  "provenance": "punch it verified by counter + landed messages in Claude, Cursor and Slack on macOS 26.6. The Cmd+letter bindings are standard macOS system shortcuts.",
  "commands": [
    { "say": ["punch it", "punch send"],            "key": "return", "mods": ["cmd"] },
    { "say": ["select all", "clear it", "wipe it"], "key": "a", "mods": ["cmd"] },
    { "say": ["copy that", "copy this"],            "key": "c", "mods": ["cmd"] },
    { "say": ["paste that", "paste this"],          "key": "v", "mods": ["cmd"] },
    { "say": ["undo that", "undo this"],            "key": "z", "mods": ["cmd"] },
    { "say": ["redo that"],                         "key": "z", "mods": ["cmd", "shift"] },
    { "say": ["save it", "save this"],              "key": "s", "mods": ["cmd"] },
    { "say": ["new chat", "fresh chat"],            "key": "n", "mods": ["cmd"] },
    { "say": ["close this", "close that"],          "key": "w", "mods": ["cmd"] },
    { "say": ["find it", "search this"],            "key": "f", "mods": ["cmd"] }
  ]
}
