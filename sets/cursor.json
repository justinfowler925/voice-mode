    { "say": ["go to file", "quick open"],            "key": "p", "mods": ["cmd"] },
    { "say": ["toggle the sidebar", "hide sidebar"],  "key": "b", "mods": ["cmd"] },
    { "say": ["toggle the panel", "hide panel"],      "key": "j", "mods": ["cmd"] },
    { "say": ["open a terminal", "show terminal"],    "key": "grave", "mods": ["ctrl"] },
    { "say": ["new cursor chat", "start a chat"],     "key": "l", "mods": ["cmd"] },
    { "say": ["open composer", "start composer"],     "key": "i", "mods": ["cmd"] },
    { "say": ["save it", "save this"],                "key": "s", "mods": ["cmd"] },
    { "say": ["close this tab"],                      "key": "w", "mods": ["cmd"] }
