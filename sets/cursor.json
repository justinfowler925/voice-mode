{
  "name": "cursor",
  "description": "Cursor. Every binding is a modified key, which is the tier that survives its Electron composer.",
  "provenance": "Cursor 1.128.0 (VS Code base), shortcuts from Cursor's and VS Code's published keybindings. punch it verified sending in Cursor by counter + outcome; the rest are documented shortcuts, not individually counter-verified.",
  "commands": [
    { "say": ["punch it", "punch send"],              "key": "return", "mods": ["cmd"] },
